# Normalise line endings for text (Unity on Windows writes CRLF; git stores LF, checks out native)
* text=auto

# ---- Unity YAML: merge with UnityYAMLMerge (see CLAUDE.md "Source control"), never diff-mangle ----
*.unity      merge=unityyamlmerge linguist-generated
*.prefab     merge=unityyamlmerge linguist-generated
*.mat        merge=unityyamlmerge linguist-generated
*.anim       merge=unityyamlmerge linguist-generated
*.controller merge=unityyamlmerge linguist-generated
*.asset      merge=unityyamlmerge linguist-generated
*.meta       merge=unityyamlmerge linguist-generated
*.physicMaterial merge=unityyamlmerge linguist-generated
*.mixer      merge=unityyamlmerge linguist-generated
*.terrainlayer merge=unityyamlmerge linguist-generated
*.lighting   merge=unityyamlmerge linguist-generated
*.preset     merge=unityyamlmerge linguist-generated
*.mask       merge=unityyamlmerge linguist-generated

# ---- Large binaries -> Git LFS ----
# 3D
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
# Images
*.png filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.JPG filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.thumb filter=lfs diff=lfs merge=lfs -text
# Audio / video
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Archives / misc binary
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
# Huge serialized assets (terrain heightmap, star cubemap)
Assets/Environment/World/WorldTerrain.asset filter=lfs diff=lfs merge=lfs -text
Assets/Environment/Weather/Stars.asset filter=lfs diff=lfs merge=lfs -text
