# ---- Unity generated (rebuilt on each machine) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
/[Bb]uild[s]Test/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Burst / IL2CPP leftovers
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Autogenerated IDE / VS files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash / build reports
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app

# Packages cache (manifest.json, packages-lock.json and embedded packages ARE kept)
/[Pp]ackages/*/.git/

# ---- ProjectZed specific ----
# Old HDRP demo moved out of Assets (3.9 GB, not used)
/_Disabled (HDRP demo)/
# Scene backups made by editor tools before big changes (local safety copies)
/SceneBackups/
# Blender auto-backups
*.blend1
*.blend2
# Python caches from Blender/Audio scripts
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db
desktop.ini
